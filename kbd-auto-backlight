#!/usr/bin/env python3
"""Adjust the keyboard backlight from the ambient light sensor.

Reads lux from iio-sensor-proxy, sets brightness via UPower (no root needed).
Dark room -> backlight on; bright room -> off. If you change the backlight
manually (keys / GNOME), auto mode pauses for OVERRIDE_PAUSE seconds.
"""
import statistics
import time
from collections import deque

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

# (max lux, brightness 0-255) -- first row whose lux bound exceeds reading wins
LEVELS = [
    (5, 110),     # dark room
    (25, 60),     # dim lamp light
    (80, 25),     # normal indoor
    (float("inf"), 0),  # bright / daylight
]
HYSTERESIS = 0.3        # lux must cross a boundary by 30% to change level
POLL_SECONDS = 3
WINDOW = 5              # readings in the median filter (~15s)
OVERRIDE_PAUSE = 30 * 60
FADE_STEPS = 10
FADE_INTERVAL_MS = 40

bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
sensor = Gio.DBusProxy.new_sync(bus, 0, None, "net.hadess.SensorProxy",
                                "/net/hadess/SensorProxy", "net.hadess.SensorProxy", None)
kbd = Gio.DBusProxy.new_sync(bus, 0, None, "org.freedesktop.UPower",
                             "/org/freedesktop/UPower/KbdBacklight",
                             "org.freedesktop.UPower.KbdBacklight", None)
sensor.call_sync("ClaimLight", None, 0, -1, None)

readings = deque(maxlen=WINDOW)
level_idx = None
last_set = None
paused_until = 0.0
fading = False


def get_brightness():
    return kbd.call_sync("GetBrightness", None, 0, -1, None).unpack()[0]


def set_brightness(v):
    global last_set
    last_set = v
    kbd.call_sync("SetBrightness", GLib.Variant("(i)", (v,)), 0, -1, None)


def fade_to(target):
    global fading
    start = get_brightness()
    if start == target:
        return
    fading = True
    steps = iter(range(1, FADE_STEPS + 1))

    def step():
        global fading
        i = next(steps, None)
        if i is None:
            fading = False
            return False
        set_brightness(round(start + (target - start) * i / FADE_STEPS))
        return True

    GLib.timeout_add(FADE_INTERVAL_MS, step)


def pick_level(lux, current):
    idx = next(i for i, (bound, _) in enumerate(LEVELS) if lux < bound)
    if current is None or idx == current:
        return idx
    # only move if we're clearly past the boundary we'd cross
    if idx > current:
        return idx if lux >= LEVELS[current][0] * (1 + HYSTERESIS) else current
    return idx if lux < LEVELS[idx][0] * (1 - HYSTERESIS) else current


def tick():
    global level_idx, paused_until, last_set
    if fading:
        return True
    now = time.monotonic()
    cur = get_brightness()
    if last_set is not None and cur != last_set:
        # Someone else changed it (keys, GNOME idle dimming, etc.)
        paused_until = now + OVERRIDE_PAUSE
        last_set = cur
        print(f"manual change to {cur}; pausing auto for {OVERRIDE_PAUSE // 60} min", flush=True)
    if now < paused_until:
        return True

    lux = sensor.get_cached_property("LightLevel").unpack()
    readings.append(lux)
    lux = statistics.median(readings)
    new_idx = pick_level(lux, level_idx)
    target = LEVELS[new_idx][1]
    if new_idx != level_idx or cur != target:
        print(f"lux={lux:.0f} -> brightness {target}", flush=True)
        level_idx = new_idx
        fade_to(target)
    return True


tick()
GLib.timeout_add_seconds(POLL_SECONDS, tick)
GLib.MainLoop().run()
